# ----------------------------------------------------------------------------
# BASE DE DONNÉES POSTGRESQL & SÉCURITÉ PRODUCTION (Render, Neon, Supabase, VPS)
# ----------------------------------------------------------------------------
# URL de connexion PostgreSQL (ex: postgres://user:password@host:5432/bati_pilot)
# Si laissée vide en développement local, l'application démarre en mode mémoire.
DATABASE_URL=""

# Secret cryptographique pour signer les tokens JWT (minimum 32 caractères aléatoires en production)
JWT_SECRET=""

# Origines autorisées pour CORS en production (séparées par des virgules)
ALLOWED_ORIGINS=""

# Mettre à "true" uniquement en préproduction/démo pour activer le sélecteur de rôles démo
ENABLE_DEMO_ACCOUNTS="false"

# APP_URL: URL publique où BATI-PILOT est hébergé (webhooks & redirections)
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Optionnel (uniquement si des fonctions IA Gemini sont activées)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ----------------------------------------------------------------------------
# PAIEMENTS RÉELS CAMEROUN & CEMAC (XAF / FCFA) — Côté Serveur Uniquement
# ----------------------------------------------------------------------------
# Option 1 : CamPay Cameroun (https://campay.net) — USSD Push MTN MoMo & Orange Money
CAMPAY_TOKEN=""
CAMPAY_APP_USERNAME=""
CAMPAY_APP_PASSWORD=""
CAMPAY_BASE_URL="https://www.campay.net/api"
CAMPAY_WEBHOOK_KEY=""

# Option 2 : CinetPay Cameroun/Afrique (https://cinetpay.com) — Mobile Money & Cartes Bancaires
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""
